# Tollm 운영(prod) 환경변수 템플릿.
# 실제 값으로 채운 뒤 서버의 /etc/tollm/tollm.env 로 복사하고 권한을 좁힌다:
#   sudo mkdir -p /etc/tollm
#   sudo cp deploy/tollm.env.example /etc/tollm/tollm.env
#   sudo nano /etc/tollm/tollm.env          # 값 채우기
#   sudo chmod 600 /etc/tollm/tollm.env      # 소유자만 읽게 (비밀 보호)
#
# prod 프로파일은 아래 값이 하나라도 비면 부팅이 실패한다(fail-fast). 이는 의도된 안전장치다.
# (systemd EnvironmentFile 형식이라 export 없이 KEY=VALUE, 따옴표 없이 작성)

SPRING_PROFILES_ACTIVE=prod

# 같은 EC2에 apt로 설치한 MySQL. username은 root 대신 tollm 전용 계정 사용(최소 권한)
DB_URL=jdbc:mysql://localhost:3306/tollm?serverTimezone=Asia/Seoul
DB_USERNAME=tollm
DB_PASSWORD=여기에_강한_DB_비밀번호

# 같은 EC2에 apt로 설치한 Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT 서명 키: 32바이트 이상 랜덤 값. 생성 예: openssl rand -base64 48
JWT_SECRET=여기에_32바이트이상_랜덤_시크릿

# [BYOK] 사용자 프로바이더 키를 암호화(AES-GCM)할 때 쓰는 비밀. 아무 긴 랜덤 문자열.
# 주의: 배포 후 이 값을 바꾸면 이미 등록된 사용자 키를 복호화할 수 없게 됨(재등록 필요).
BYOK_ENCRYPTION_KEY=여기에_랜덤_시크릿_한번_정하면_바꾸지_말것

# LLM 프로바이더 키 (서버 공용키). 순수 BYOK에서는 개인 요청에 쓰이지 않고, 팀 요청(팀 BYOK 전까지)
# 에만 쓰인다. 팀 프록시를 안 쓸 거면 비워둬도 되지만, prod 프로파일은 fail-fast라 값이 필요하다.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
